#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/modifiers.h>

// Home row mods macro

#define HRML(k1,k2,k3,k4) &ht LSHFT k1  &ht LALT k2  &ht LCTRL k3  &ht LGUI k4
#define HRMR(k1,k2,k3,k4) &ht RGUI k1  &ht RCTRL k2  &ht RALT k3  &ht RSHFT k4

/ {
    behaviors {
        ht: hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <220>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <100>;
            bindings = <&kp>, <&kp>;
        };

        bspc_morph: bspc_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp BACKSPACE>, <&kp LC(BSPC)>;
            mods = <(MOD_LGUI)>;
        };

        bspc_ht: bspc_ht {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&bspc_morph>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <0 0>;
            then-layer = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
&kp Q  &kp W  &kp E  &kp R         &kp T          &kp Y            &kp U             &kp I      &kp O                &kp P
&kp A  &kp S  &kp D  &kp F         &kp G          &kp H            &kp J             &kp K      &kp L                &kp SQT
&kp Z  &kp X  &kp C  &kp V         &kp B          &kp N            &kp M             &kp COMMA  &mt LEFT_ALT PERIOD  &mt LCTRL SLASH
                     &kp LEFT_GUI  &lt 1 SPACE    &bspc_ht 2 0     &mt LSHIFT ENTER
            >;
        };

        symbols {
            bindings = <
&kp EXCL       &kp AT         &kp HASH      &kp DOLLAR     &kp PERCENT             &kp CARET              &kp N7  &kp N8  &kp N9  &trans
&kp GRAVE      &kp EQUAL      &kp MINUS     &kp SEMICOLON  &kp LEFT_PARENTHESIS    &kp RIGHT_PARENTHESIS  &kp N4  &kp N5  &kp N6  &kp N0
&kp BACKSLASH  &kp AMPERSAND  &kp ASTERISK  &kp SEMI       &kp LBKT                &kp RBKT               &kp N1  &kp N2  &kp N3  &trans
                                            &trans         &trans                  &trans                 &trans
            >;
        };

        extra {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3      &bt BT_CLR    &trans    &trans    &trans  &trans     &trans
&trans        &kp TAB       &kp ENTER     &kp ESCAPE        &trans        &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &trans
&kp C_VOL_DN  &kp C_VOL_UP  &kp C_PREV    &kp C_PLAY_PAUSE  &kp C_NEXT    &trans    &trans    &trans  &trans     &trans
                                          &trans            &trans        &trans    &trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
                        &trans  &trans    &trans  &trans
            >;
        };
    };
};
