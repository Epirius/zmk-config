#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/modifiers.h>

#define MEGA      1
#define MEDIA_BT  2

/ {
    behaviors {
        // Backspace normally. If Super (LGUI) is already held (e.g. you're
        // mid Super+something), sends Ctrl+Backspace instead so Super+Backspace
        // deletes a whole word rather than doing nothing useful.
        bspc_morph: bspc_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp BSPC>, <&kp LC(BSPC)>;
            mods = <(MOD_LGUI)>;
        };

        // Norwegian letters via the GTK/IBus Unicode input method
        // (Ctrl+Shift+U, hex code, Enter). Works out of the box in most
        // GTK apps on Linux; unreliable in raw terminals and some
        // Qt/Electron apps. If that's a problem in practice, the
        // commented-out `wtype` binds in your Hyprland config are a more
        // universal fallback.
        uni_ae: uni_ae {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL &kp LSHFT>
                , <&macro_tap &kp U>
                , <&macro_release &kp LCTRL &kp LSHFT>
                , <&macro_tap &kp E &kp N6>
                , <&macro_tap &kp RET>
                ;
        };

        uni_oe: uni_oe {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL &kp LSHFT>
                , <&macro_tap &kp U>
                , <&macro_release &kp LCTRL &kp LSHFT>
                , <&macro_tap &kp F &kp N8>
                , <&macro_tap &kp RET>
                ;
        };

        uni_aa: uni_aa {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL &kp LSHFT>
                , <&macro_tap &kp U>
                , <&macro_release &kp LCTRL &kp LSHFT>
                , <&macro_tap &kp E &kp N5>
                , <&macro_tap &kp RET>
                ;
        };

        uni_AE: uni_AE {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL &kp LSHFT>
                , <&macro_tap &kp U>
                , <&macro_release &kp LCTRL &kp LSHFT>
                , <&macro_tap &kp C &kp N6>
                , <&macro_tap &kp RET>
                ;
        };

        uni_OE: uni_OE {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL &kp LSHFT>
                , <&macro_tap &kp U>
                , <&macro_release &kp LCTRL &kp LSHFT>
                , <&macro_tap &kp D &kp N8>
                , <&macro_tap &kp RET>
                ;
        };

        uni_AA: uni_AA {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL &kp LSHFT>
                , <&macro_tap &kp U>
                , <&macro_release &kp LCTRL &kp LSHFT>
                , <&macro_tap &kp C &kp N5>
                , <&macro_tap &kp RET>
                ;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
&kp Q      &kp W      &kp E      &kp R      &kp T           &kp Y     &kp U            &kp I               &kp O                 &kp P
&kp A      &kp S      &kp D      &kp F      &kp G           &kp H     &kp J            &kp K               &kp L                 &mt RIGHT_SHIFT SQT
&kp Z      &kp X      &kp C      &kp V      &kp B           &kp N     &mt RALT M       &mt RIGHT_CONTROL COMMA  &mt RIGHT_GUI PERIOD  &kp FSLH
                                  &kp LGUI   &lt MEDIA_BT SPACE       &bspc_morph      &lt MEGA RET
            >;
        };

        mega {
            bindings = <
&kp N1      &kp N2      &kp N3    &kp N4    &kp N5          &kp N6    &kp N7    &kp N8    &kp N9    &kp N0
&kp LSHFT   &kp LCTRL   &kp LALT  &trans    &trans          &kp ESC   &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT
&kp GRAVE   &kp MINUS   &kp EQUAL &kp LBKT  &kp RBKT        &kp BACKSLASH  &kp SEMI  &trans  &trans  &trans
                                  &trans    &trans          &trans    &trans
            >;
        };

        media_bt {
            bindings = <
&bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2      &bt BT_SEL 3      &bt BT_CLR     &trans  &trans  &trans  &trans  &trans
&uni_ae         &uni_oe         &uni_aa           &trans            &trans         &uni_AE  &uni_OE  &uni_AA  &trans  &trans
&kp C_VOL_DN    &kp C_VOL_UP    &kp C_PREV        &kp C_PLAY_PAUSE  &kp C_NEXT     &trans  &trans  &trans  &trans  &trans
                                                  &trans            &trans         &trans  &trans
            >;
        };
    };
};
